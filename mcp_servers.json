{
  "mcpServers": {
    "memory": {
      "command": "python",
      "args": ["-m", "mcp_server_memory"],
      "env": {
        "MEMORY_STORE_PATH": "./data/memory_store.json"
      }
    },
    "google-calendar": {
      "command": "python",
      "args": ["-m", "mcp_server_gcalendar"],
      "env": {
        "CALENDAR_DEFAULT_TIMEZONE": "America/New_York"
      }
    },
    "slack": {
      "command": "python",
      "args": ["-m", "mcp_server_slack"],
      "env": {
        "SLACK_CHANNEL": "#engineering-briefs"
      }
    }
  }
}
